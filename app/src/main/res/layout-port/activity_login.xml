<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            style="@style/HeroTitle"
            android:text="@string/login_title" />
        <EditText
            android:id="@+id/login_email"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:hint="@string/login_email_hint"
            android:inputType="textEmailAddress"
            android:autofillHints="username"
            android:singleLine="true"
            android:textColor="@color/text" />
        <EditText
            android:id="@+id/login_password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/login_password_hint"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:singleLine="true"
            android:textColor="@color/text" />
        <TextView
            android:id="@+id/login_submit"
            style="@style/ActionButton"
            android:text="@string/login_submit" />
        <TextView
            android:id="@+id/login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="26dp"
            android:textColor="@color/accent"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/login_on_tv"
            style="@style/ActionButton"
            android:text="@string/login_on_tv" />
        <TextView
            android:id="@+id/login_new_code"
            style="@style/ActionButton"
            android:text="@string/login_new_code" />
        <FrameLayout
            android:id="@+id/qr_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/qr_card_bg"
            android:padding="10dp"
            android:visibility="invisible">
            <ImageView
                android:id="@+id/qr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/login_qr_description" />
        </FrameLayout>
        <TextView
            android:id="@+id/login_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
