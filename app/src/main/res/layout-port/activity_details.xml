<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/art"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/title"
                    style="@style/HeroTitle"
                    android:layout_width="match_parent" />

                <TextView
                    android:id="@+id/original_title"
                    style="@style/Meta"
                    android:layout_width="match_parent"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/meta"
                    style="@style/Meta"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:maxLines="3" />

                <TextView
                    android:id="@+id/ratings"
                    style="@style/Meta.Accent"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/description"
                    style="@style/Description"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:maxLines="8" />

                <LinearLayout
                    android:id="@+id/buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/play"
                        style="@style/ActionButton.Primary"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/ic_play"
                        android:text="@string/play" />

                    <TextView
                        android:id="@+id/next"
                        style="@style/ActionButton"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/ic_skip_next"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/episodes"
                        style="@style/ActionButton"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/ic_episodes"
                        android:text="@string/episodes_button"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/translator"
                        style="@style/ActionButton"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/ic_voice"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/watched"
                        style="@style/ActionButton"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/ic_check"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/site"
                        style="@style/ActionButton"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/ic_series"
                        android:text="@string/on_site" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_episodes_panel" />

    <include layout="@layout/view_choice_panel" />
</FrameLayout>
